---
import { listedPages } from "../lib/pages";

interface Props {
  title?: string;
  description?: string;
  photo?: string;
  /**
   * Render the intro gate: a full-screen looping video with the word ENTER,
   * dismissed by a click or tap. Only the homepage sets this. Every other
   * page renders with no video and no script, exactly as before.
   */
  splash?: boolean;
  /**
   * Render the body as a scrolling column of captioned photos rather than the
   * text column. The page's Markdown supplies the <figure> elements.
   */
  gallery?: boolean;
}

const { title, description, photo, splash, gallery } = Astro.props;

// "About · Ryan Watt", "Home · Ryan Watt".
const pageTitle = `${title ?? "Home"} · Ryan Watt`;

const pages = await listedPages();

// Which nav link is the page you're on.
//
// Normalising matters here: because build.format is "file", at build time
// this is "/about.html" even though the browser will show "/about". Compare
// the raw values and the highlight silently never appears in production
// while looking correct in dev.
const current =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "/")
    .replace(/(.)\/+$/, "$1") || "/";

// The intro gate's two scripts, kept as raw strings and injected verbatim with
// set:html so nothing bundles or rewrites them. #splash is hidden by default
// in the stylesheet; the head script adds `intro` to <html> before the body
// paints, but only for a first-time visitor (or `?enter` in the URL, to
// preview it again). So: no JavaScript, or already entered — the gate never
// shows and the homepage is what you get, with no flash either way.
const introReveal =
  "try{if(location.search.indexOf('enter')>-1||!localStorage.getItem('rbw-entered'))" +
  "document.documentElement.className+=' intro';}" +
  "catch(e){document.documentElement.className+=' intro';}";

// Runs at the end of the body. Bails unless the gate is actually showing, so a
// returning visitor never downloads the video. Otherwise it attaches the video
// (skipped when the visitor prefers reduced motion) and wires up the dismiss.
const introDismiss =
  "(function(){var d=document;if(!d.documentElement.classList.contains('intro'))return;" +
  "var s=d.getElementById('splash');if(!s)return;" +
  "var reduce=false;try{reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;}catch(e){}" +
  "var v=d.getElementById('splash-video');" +
  "if(v&&!reduce){var src=d.createElement('source');src.src='/enter-whistler.mp4';src.type='video/mp4';" +
  "v.appendChild(src);v.load();" +
  "var tryplay=function(){var p=v.play();if(p&&p.catch)p.catch(function(){});};" +
  "tryplay();v.addEventListener('canplay',tryplay);v.addEventListener('loadeddata',tryplay);}" +
  "function enter(){try{localStorage.setItem('rbw-entered','1');}catch(e){}" +
  "s.classList.add('leaving');" +
  "setTimeout(function(){if(v){try{v.pause();}catch(e){}}if(s.parentNode)s.remove();},650);}" +
  "s.addEventListener('click',enter);" +
  "s.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();enter();}});})();";

// Homepage only. The blank homepage is a doorway you pass through once: the
// name isn't a link and there's no Home item, so nothing points back to it.
// This makes the browser's Back button honour that too — a nav click from the
// homepage replaces it in history rather than stacking on top, so once you're
// in a section there's no returning to the blank page. Modifier- and
// middle-clicks are left alone so "open in new tab" still works.
const homeNavReplace =
  "document.addEventListener('click',function(e){" +
  "var a=e.target.closest?e.target.closest('a[href]'):null;if(!a)return;" +
  "if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||e.button!==0)return;" +
  "var h=a.getAttribute('href');if(!h||h.charAt(0)==='#')return;" +
  "e.preventDefault();location.replace(a.href);});";
---

<html lang="en">
  <head>
    <link rel="stylesheet" href="/style.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {splash && <script is:inline set:html={introReveal} />}
  </head>
  <body class={photo ? "full-bleed" : undefined}>
    {/* photo → single full-bleed image; gallery → scrolling captioned column;
        otherwise the standard text column. */}
    {splash && (
      <div id="splash" role="button" tabindex="0" aria-label="Enter">
        {/*
          No <source> in the markup on purpose: the video is attached by the
          script below only for a first-time visitor with motion allowed.
          Everyone else sees the poster still — and returning visitors never
          fetch the video at all. The orbit clip is /enter-whistler.mp4: a ~6s
          boomerang aerial of Whistler Peak (rendered in Google Earth Studio),
          sweeping out and easing back so the loop is seamless.
        */}
        <video
          id="splash-video"
          poster="/enter-whistler.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <svg id="splash-target" width="64" height="64" viewBox="0 0 64 64" aria-hidden="true">
          <circle cx="32" cy="32" r="26" fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="1"></circle>
          <circle cx="32" cy="32" r="17" fill="none" stroke="#fff" stroke-opacity="1" stroke-width="1"></circle>
          <circle cx="32" cy="32" r="8" fill="none" stroke="#fff" stroke-opacity="0.5" stroke-width="1"></circle>
          <circle cx="32" cy="32" r="1.2" fill="#fff" fill-opacity="0.9"></circle>
        </svg>
      </div>
    )}
    <div id="menu">
      <span class="title">Ryan Watt</span>
      <ul>
        {pages.map((page) => (
          <li>
            <a
              href={`/${page.id}`}
              aria-current={current === `/${page.id}` ? "page" : undefined}
            >
              {page.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {photo ? (
      <div id="photo-frame" style={`background-image: url(${photo})`} />
    ) : gallery ? (
      <div id="gallery">
        <slot />
      </div>
    ) : (
      <>
        <div id="left">&nbsp;</div>
        <div id="content">
          <slot />
        </div>
      </>
    )}
    {splash && <script is:inline set:html={introDismiss} />}
    {current === "/" && <script is:inline set:html={homeNavReplace} />}
    {gallery && <script is:inline src="/gallery.js" defer></script>}
  </body>
</html>
