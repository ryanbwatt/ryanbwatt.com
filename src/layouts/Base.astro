---
import { listedPages } from "../lib/pages";

interface Props {
  title?: string;
  description?: string;
  photo?: string;
  /**
   * Render the intro gate: a full-screen still photo with the word Enter,
   * dismissed by a click or tap. Only the homepage sets this. Every other
   * page renders with no gate and none of its script.
   */
  splash?: boolean;
  /**
   * Render the body as a scrolling column of captioned photos rather than the
   * text column. The page's Markdown supplies the <figure> elements.
   */
  gallery?: boolean;
}

const { title, description, photo, splash, gallery } = Astro.props;

// "About · Ryan Watt", "Home · Ryan Watt".
const pageTitle = `${title ?? "Home"} · Ryan Watt`;

const pages = await listedPages();

// Identity metadata. One preferred portrait, one description and one list of
// profiles, so search engines and link previews all pick the same photo and
// the same person. The Person block is on every page; About also declares
// itself the ProfilePage for that Person, which is what Google reads for
// name-search profile results.
const siteUrl = "https://ryanwatt.ca";
const portrait = `${siteUrl}/ryan-watt.jpg`;
const person = {
  "@type": "Person",
  "@id": `${siteUrl}/#ryan-watt`,
  name: "Ryan Watt",
  url: `${siteUrl}/about`,
  image: portrait,
  jobTitle: "Senior Account Manager",
  worksFor: { "@type": "Organization", name: "Kaltura", url: "https://corp.kaltura.com" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Columbia University" },
  homeLocation: { "@type": "Place", name: "Brooklyn, New York" },
  sameAs: [
    "https://www.linkedin.com/in/ryanwattny/",
    "https://www.instagram.com/ryanwatt.ca/",
    "https://github.com/ryanbwatt",
    "https://results.nyrr.org/runner/34525309/races",
    "https://gocolumbialions.com/sports/lightweight-rowing/roster/ryan-watt/11068",
  ],
};

// Which nav link is the page you're on.
//
// Normalising matters here: because build.format is "file", at build time
// this is "/about.html" even though the browser will show "/about". Compare
// the raw values and the highlight silently never appears in production
// while looking correct in dev.
const current =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "/")
    .replace(/(.)\/+$/, "$1") || "/";

const canonical = `${siteUrl}${current === "/" ? "/" : current}`;
const metaDescription =
  description ?? "Ryan Watt lives in Brooklyn and works on enterprise accounts at Kaltura.";
const jsonLd = JSON.stringify(
  current === "/about"
    ? {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        url: canonical,
        mainEntity: person,
      }
    : { "@context": "https://schema.org", ...person },
);

// The intro gate's two scripts, kept as raw strings and injected verbatim with
// set:html so nothing bundles or rewrites them. #splash is hidden by default
// in the stylesheet; the head script adds `intro` to <html> before the body
// paints, but only for a first-time visitor (or `?enter` in the URL, to
// preview it again). So: no JavaScript, or already entered — the gate never
// shows and the homepage is what you get, with no flash either way.
const introReveal =
  "try{if(location.search.indexOf('enter')>-1||!localStorage.getItem('rbw-entered'))" +
  "document.documentElement.className+=' intro';}" +
  "catch(e){document.documentElement.className+=' intro';}";

// Runs at the end of the body. Bails unless the gate is actually showing, then
// wires up the dismiss: a click or Enter/Space fades the gate out, removes it,
// and remembers you've entered so it never shows again.
const introDismiss =
  "(function(){var d=document;if(!d.documentElement.classList.contains('intro'))return;" +
  "var s=d.getElementById('splash');if(!s)return;" +
  "function enter(){try{localStorage.setItem('rbw-entered','1');}catch(e){}" +
  "s.classList.add('leaving');" +
  "setTimeout(function(){if(s.parentNode)s.remove();},650);}" +
  "s.addEventListener('click',enter);" +
  "s.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();enter();}});})();";

// Homepage only. The blank homepage is a doorway you pass through once: the
// name isn't a link and there's no Home item, so nothing points back to it.
// This makes the browser's Back button honour that too — a nav click from the
// homepage replaces it in history rather than stacking on top, so once you're
// in a section there's no returning to the blank page. Modifier- and
// middle-clicks are left alone so "open in new tab" still works.
const homeNavReplace =
  "document.addEventListener('click',function(e){" +
  "var a=e.target.closest?e.target.closest('a[href]'):null;if(!a)return;" +
  "if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||e.button!==0)return;" +
  "var h=a.getAttribute('href');if(!h||h.charAt(0)==='#')return;" +
  "e.preventDefault();location.replace(a.href);});";
---

<html lang="en">
  <head>
    <link rel="stylesheet" href="/style.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={current === "/about" ? "profile" : "website"} />
    <meta property="og:site_name" content="Ryan Watt" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={portrait} />
    <meta property="og:image:alt" content="Ryan Watt" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    {splash && <script is:inline set:html={introReveal} />}
  </head>
  <body class={photo ? "full-bleed" : undefined}>
    {/* photo → single full-bleed image; gallery → scrolling captioned column;
        otherwise the standard text column. */}
    {splash && (
      <div id="splash" role="button" tabindex="0" aria-label="Enter">
        {/*
          A still photo fills the gate (object-fit: cover). #splash-stage holds
          the photo's 3:2 box while covering the viewport, so the "Enter" label
          — positioned as a percentage of the stage — stays pinned to the sun no
          matter the window shape. The label is the site's own 13px text in
          black, sitting over the blown-out sun where black reads cleanly. The
          arrow is the same → the photo lightbox uses. Move it by nudging the
          two percentages on #splash-enter in the stylesheet.
        */}
        <div id="splash-stage">
          <img id="splash-photo" src="/enter.jpg" alt="" />
          <span id="splash-enter">Enter&nbsp;→</span>
        </div>
      </div>
    )}
    <div id="menu">
      <span class="title">Ryan Watt</span>
      <ul>
        {pages.map((page) => (
          <li>
            <a
              href={`/${page.id}`}
              aria-current={current === `/${page.id}` ? "page" : undefined}
            >
              {page.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {photo ? (
      <div id="photo-frame" style={`background-image: url(${photo})`} />
    ) : gallery ? (
      <div id="gallery">
        <slot />
      </div>
    ) : (
      <>
        <div id="left">&nbsp;</div>
        <div id="content">
          <slot />
        </div>
      </>
    )}
    {splash && <script is:inline set:html={introDismiss} />}
    {current === "/" && <script is:inline set:html={homeNavReplace} />}
    {gallery && <script is:inline src="/gallery.js" defer></script>}
  </body>
</html>
