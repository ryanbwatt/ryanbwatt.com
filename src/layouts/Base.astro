---
import { listedPages } from "../lib/pages";

interface Props {
  title?: string;
  description?: string;
  photo?: string;
  /**
   * Render the body as a scrolling column of captioned photos rather than the
   * text column. The page's Markdown supplies the <figure> elements.
   */
  gallery?: boolean;
  /**
   * Render this page as if it were another path, for the nav highlight only.
   * The homepage shows About, so it passes "/about" and the About link is
   * marked current. Canonical URL and Search Console tag still use the real path.
   */
  as?: string;
}

const { title, description, photo, gallery, as } = Astro.props;

// "About · Ryan Watt"; the homepage is just "Ryan Watt".
const pageTitle = !title || title === "Ryan Watt" ? "Ryan Watt" : `${title} · Ryan Watt`;

const pages = await listedPages();

// Identity metadata. One preferred portrait, one description and one list of
// profiles, so search engines and link previews all pick the same photo and
// the same person. The Person block is on every page; About also declares
// itself the ProfilePage for that Person, which is what Google reads for
// name-search profile results.
const siteUrl = "https://ryanwatt.ca";
const portrait = `${siteUrl}/ryan-watt.jpg`;
const person = {
  "@type": "Person",
  "@id": `${siteUrl}/#ryan-watt`,
  name: "Ryan Watt",
  url: `${siteUrl}/about`,
  image: portrait,
  jobTitle: "Senior Account Manager, Emerging Markets",
  worksFor: { "@type": "Organization", name: "Kaltura", url: "https://corp.kaltura.com" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Columbia University" },
  homeLocation: { "@type": "Place", name: "Brooklyn, New York" },
  sameAs: [
    "https://www.linkedin.com/in/ryanwattny/",
    "https://www.instagram.com/ryanwatt.ca/",
    "https://github.com/ryanbwatt",
    "https://results.nyrr.org/runner/34525309/races",
    "https://gocolumbialions.com/sports/lightweight-rowing/roster/ryan-watt/11068",
  ],
};

// Which nav link is the page you're on.
//
// Normalising matters here: because build.format is "file", at build time
// this is "/about.html" even though the browser will show "/about". Compare
// the raw values and the highlight silently never appears in production
// while looking correct in dev.
const current =
  Astro.url.pathname
    .replace(/\.html$/, "")
    .replace(/\/index$/, "/")
    .replace(/(.)\/+$/, "$1") || "/";

const canonical = `${siteUrl}${current === "/" ? "/" : current}`;
const metaDescription =
  description ?? "Ryan Watt lives in Brooklyn and works on enterprise accounts at Kaltura.";
const jsonLd = JSON.stringify(
  current === "/about"
    ? {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        url: canonical,
        mainEntity: person,
      }
    : { "@context": "https://schema.org", ...person },
);

---

<html lang="en">
  <head>
    <link rel="stylesheet" href="/style.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {/* Google Search Console ownership for https://ryanwatt.ca/. Keep it:
        removing it un-verifies the property. Homepage only is enough. */}
    {current === "/" && (
      <meta name="google-site-verification" content="__Vq7hWX2Wd2Vi5eMeNJJJlKsIX-zo9BS3SYBUGgL-Q" />
    )}
    <meta property="og:type" content={current === "/about" ? "profile" : "website"} />
    <meta property="og:site_name" content="Ryan Watt" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={portrait} />
    <meta property="og:image:alt" content="Ryan Watt" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body class={photo ? "full-bleed" : undefined}>
    {/* photo → single full-bleed image; gallery → scrolling captioned column;
        otherwise the standard text column. */}
    <div id="menu">
      <span class="title">Ryan Watt</span>
      <ul>
        {pages.map((page) => (
          <li>
            <a
              href={`/${page.id}`}
              aria-current={(as ?? current) === `/${page.id}` ? "page" : undefined}
            >
              {page.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {photo ? (
      <div id="photo-frame" style={`background-image: url(${photo})`} />
    ) : gallery ? (
      <div id="gallery">
        <slot />
      </div>
    ) : (
      <>
        <div id="left">&nbsp;</div>
        <div id="content">
          <slot />
        </div>
      </>
    )}
    {gallery && <script is:inline src="/gallery.js" defer></script>}
  </body>
</html>
