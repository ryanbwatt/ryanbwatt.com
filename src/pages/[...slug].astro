---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { allPages } from "../lib/pages";

// One route serves every page in the collection. The filename is the URL:
// src/content/pages/fast.md -> /fast
export async function getStaticPaths() {
  const pages = await allPages();
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const updated = page.data.updated?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<Base
  title={page.data.title}
  description={page.data.description ?? page.data.blurb}
>
  <article class="measure">
    <h1>{page.data.title}</h1>
    {updated && <p class="muted stamp">Last revised {updated}</p>}

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  article {
    padding-block-start: var(--rhythm);
  }

  .stamp {
    margin-block-start: calc(var(--rhythm) * 0.4);
  }

  .prose {
    margin-block-start: calc(var(--rhythm) * 1.5);
  }

  /* First heading in a page shouldn't push away from the title. */
  .prose :global(> :first-child) {
    margin-block-start: 0;
  }
</style>
