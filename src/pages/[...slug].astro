---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { allPages } from "../lib/pages";

// The filename is the URL: src/content/pages/fast.md -> /fast
export async function getStaticPaths() {
  const pages = await allPages();
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

{/*
  No <h1>. The page name is in the <title> and in the nav, and repeating it
  above the text is a habit from templates — Collison's /about just starts
  with a paragraph. Write your own headings inside the Markdown if a page
  needs them.
*/}
<Base
  title={page.data.title}
  description={page.data.description}
  photo={page.data.photo}
>
  <Content />
</Base>
