---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

// The homepage is the About page: photo, one line, contact details. A first
// visitor lands on who Ryan is, with no gate or blank page in front of it.
// /about still exists and is the canonical About URL; the nav marks About as
// the current page here too.
const about = await getEntry("pages", "about");
if (!about) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(about);
---

<Base title="Ryan Watt" description={about.data.description} as="/about">
  <Content />
</Base>
