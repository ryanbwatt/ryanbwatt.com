---
import Base from "../layouts/Base.astro";
import { listedPages } from "../lib/pages";

// The index is derived from the content collection. Drop a markdown file in
// src/content/pages/ and its link appears here on the next build. There is
// nothing to update by hand.
const pages = await listedPages();
---

<Base showHeader={false}>
  <div class="masthead measure">
    <h1>Ryan Watt</h1>
    <p class="intro">
      I work in customer success. This is where I keep the things I think
      about for long enough to write down.
    </p>
  </div>

  {
    pages.length > 0 && (
      <nav class="index" aria-label="Pages">
        <ul role="list">
          {pages.map((page) => (
            <li>
              <a href={`/${page.id}`}>{page.data.title}</a>
              {page.data.blurb && <span class="blurb">{page.data.blurb}</span>}
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Base>

<style>
  /* Everything on this page is one size: var(--text-base). Hierarchy comes
     from weight and colour only, never scale. That's the Collison move — his
     homepage has no hero heading, just a page of evenly-sized text — and it's
     what stops an index of two entries from looking like a landing page. */
  .masthead {
    padding-block-start: calc(var(--rhythm) * 2);
  }

  .masthead h1 {
    font-size: var(--text-base);
    font-weight: var(--weight-demi);
    letter-spacing: normal;
  }

  .intro {
    margin-block-start: calc(var(--rhythm) * 0.75);
    color: var(--ink);
  }

  /* Rules run the full width of the page frame while the text stays left,
     which keeps the list reading as an index rather than a table. */
  .index {
    margin-block-start: calc(var(--rhythm) * 2.5);
    max-width: var(--measure-wide);
  }

  .index ul {
    padding: 0;
    border-block-start: 1px solid var(--rule);
  }

  .index li {
    margin: 0;
    padding-block: calc(var(--rhythm) * 0.7);
    border-block-end: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75em;
    align-items: baseline;
  }

  .index a {
    color: var(--ink-strong);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  .index a:hover {
    color: var(--accent);
  }

  .blurb {
    color: var(--ink-mute);
  }
</style>
